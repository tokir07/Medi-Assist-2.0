# MediAssist Environment Variable Template
PROJECT_NAME="MediAssist — AI-Powered Clinical Pre-Consultation"
DATABASE_URL=postgresql://postgres:12345678@localhost:5432/mediAssist

# Security & Auth
JWT_SECRET_KEY=mediassist_super_secret_jwt_key_2026_clinical_pre_consultation
GOOGLE_CLIENT_ID=mock_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock_google_client_secret

# OpenRouter AI Gateway Configuration
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=https://mediassist.app
